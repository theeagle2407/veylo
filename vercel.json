{
  "version": 2,
  "buildCommand": "node scripts/build-cloud-wallet.mjs",
  "outputDirectory": "vercel-public",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "functions": {
    "api/hosting-check.mjs": {
      "includeFiles": "cloud-bin/**",
      "excludeFiles": "{tools/nu7-wallet/**,.veylo-cloud-build/**,data/**,test/**}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/api/hosting-check/?$",
      "dest": "/api/hosting-check"
    },
    {
      "src": "/(.*)",
      "dest": "https://website-bluetooth-spa-departments.trycloudflare.com/$1"
    }
  ]
}
