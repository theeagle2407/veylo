{
  "version": 2,
  "buildCommand": "node scripts/build-cloud-wallet.mjs",
  "outputDirectory": "vercel-public",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{cloud-bin/**,public/**,private-products/**}",
      "excludeFiles": "{tools/**,.veylo-cloud-build/**,data/**,test/**,scripts/**,.veylo-cloud/**,.env*}",
      "maxDuration": 300
    },
    "api/hosting-check.mjs": {
      "includeFiles": "cloud-bin/**",
      "excludeFiles": "{tools/**,.veylo-cloud-build/**,data/**,test/**,scripts/**,.veylo-cloud/**,.env*}",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "^/api/hosting-check/?$",
      "dest": "/api/hosting-check"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
